{
  "name": "@magic-co/docs-engine",
  "version": "0.4.0",
  "description": "Turn the Markdown and yaml diagram blocks of a repo into a local docs site, with live reload and a blocking lint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magic-co/docs-engine.git"
  },
  "homepage": "https://github.com/magic-co/docs-engine#readme",
  "bugs": {
    "url": "https://github.com/magic-co/docs-engine/issues"
  },
  "type": "module",
  "bin": {
    "docs": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "components",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "node src/cli.ts dev",
    "lint:docs": "node src/cli.ts lint"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/web": "0.1.0-beta.5",
    "ajv": "8.20.0",
    "decode-named-character-reference": "1.3.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vite": "8.3.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
