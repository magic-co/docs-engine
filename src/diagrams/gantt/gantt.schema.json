{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Gantt chart: tasks in sections on a time axis. The dates set the layout",
  "type": "object",
  "required": [
    "title",
    "sections",
    "tasks"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "description": "The row groups, in order.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tasks": {
      "description": "The tasks, in order inside each section.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "section"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "description": "A section id."
          },
          "on": {
            "$ref": "#/$defs/date",
            "description": "A milestone on this date."
          },
          "start": {
            "$ref": "#/$defs/date",
            "description": "The first day."
          },
          "after": {
            "type": "string",
            "description": "A task id. The task starts the day after that task ends. A milestone sits on its last day."
          },
          "end": {
            "$ref": "#/$defs/date",
            "description": "The last day, inclusive."
          },
          "days": {
            "type": "integer",
            "minimum": 1
          },
          "weeks": {
            "type": "integer",
            "minimum": 1
          },
          "focal": {
            "type": "boolean",
            "description": "The one task that stands out, such as the date that cannot move."
          },
          "description": {
            "type": "string"
          },
          "details": {
            "description": "Labelled facts in order. A list prints as bullets.",
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "href": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
